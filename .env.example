# Copy to .env and fill in what you have. Every key is read through
# src/investment_committee/config.py; nothing else reads the environment.
# .env is gitignored. Never commit a real key.

# OpenAI API key, from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model used by the planner
OPENAI_MODEL=gpt-6-luna

# Shared OpenAI request timeout in seconds
OPENAI_TIMEOUT=30

# Anthropic API key, from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google AI Studio key, from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# NewsAPI key, from https://newsapi.org/register
NEWSAPI_KEY=

# FRED API key, from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
